
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#64172e">
<title>Vara Laxmi | Royal Sarees</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --maroon: #64172e;
  --dark: #35101e;
  --gold: #d6ad60;
  --cream: #fff8ee;
  --text: #38242a;
}

html { scroll-behavior: smooth; }

body {
  font-family: Georgia, serif;
  background: var(--cream);
  color: var(--text);
}

header {
  background: var(--dark);
  color: white;
  text-align: center;
  padding: 27px 12px;
  border-bottom: 3px solid var(--gold);
}

.logo {
  color: var(--gold);
  font-size: 35px;
  letter-spacing: 4px;
  font-weight: bold;
}

.tagline {
  margin-top: 7px;
  font-size: 12px;
  letter-spacing: 3px;
}

nav {
  background: var(--maroon);
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 25px;
  padding: 15px;
}

nav a {
  color: white;
  text-decoration: none;
  font-size: 14px;
}

nav a:hover { color: var(--gold); }

.hero {
  min-height: 420px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 50px 20px;
  background:
  linear-gradient(#2d1019a8,#2d1019a8),
  url("https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=1400")
  center/cover;
  color: white;
}

.hero-content { max-width: 650px; }

.hero h1 {
  font-size: clamp(35px, 7vw, 58px);
  color: var(--gold);
  margin-bottom: 18px;
}

.hero p {
  font-size: 18px;
  line-height: 1.7;
  margin-bottom: 25px;
}

.btn {
  display: inline-block;
  background: var(--gold);
  color: var(--dark);
  padding: 13px 25px;
  border: none;
  border-radius: 4px;
  text-decoration: none;
  font-weight: bold;
  cursor: pointer;
}

.btn:hover { background: #edca83; }

.section {
  padding: 55px 6%;
}

.section-title {
  text-align: center;
  color: var(--maroon);
  font-size: 30px;
  margin-bottom: 12px;
}

.subtitle {
  text-align: center;
  color: #806a62;
  margin-bottom: 30px;
  line-height: 1.6;
}

.categories {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
  margin-bottom: 25px;
}

.categories button {
  padding: 10px 18px;
  border: 1px solid var(--maroon);
  background: transparent;
  color: var(--maroon);
  border-radius: 25px;
  cursor: pointer;
}

.categories button.active,
.categories button:hover {
  background: var(--maroon);
  color: white;
}

.search {
  display: block;
  max-width: 450px;
  width: 100%;
  margin: 0 auto 30px;
  padding: 13px;
  border: 1px solid #d5bdad;
  border-radius: 5px;
  font-size: 15px;
}

.products {
  display: grid;
  grid-template-columns:
  repeat(auto-fit, minmax(220px, 1fr));
  gap: 25px;
}

.product {
  background: white;
  border: 1px solid #eee0d1;
  border-radius: 8px;
  overflow: hidden;
  text-align: center;
  padding-bottom: 20px;
  box-shadow: 0 4px 15px #4b172010;
}

.product img {
  width: 100%;
  height: 260px;
  object-fit: cover;
  background: #ead9cb;
}

.product h3 {
  color: var(--maroon);
  margin: 15px 8px 8px;
}

.product p {
  color: #806b61;
  font-size: 13px;
}

.price {
  font-size: 21px !important;
  color: #a27a29 !important;
  font-weight: bold;
  margin: 12px;
}

.product .btn { margin: 5px; }

.about {
  background: #f0e2d3;
  text-align: center;
}

.about p {
  max-width: 700px;
  margin: 20px auto;
  line-height: 1.9;
}

.features {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(180px,1fr));
  gap: 20px;
  margin-top: 30px;
}

.feature {
  padding: 22px;
  background: white;
  border-radius: 8px;
}

.feature h3 {
  color: var(--maroon);
  margin-bottom: 10px;
}

.contact {
  text-align: center;
  line-height: 2.2;
}

.contact a {
  color: var(--maroon);
}

footer {
  text-align: center;
  background: var(--dark);
  color: white;
  padding: 25px 10px;
  line-height: 2;
}

.cart {
  position: fixed;
  bottom: 20px;
  right: 15px;
  z-index: 10;
  background: var(--maroon);
  color: white;
  padding: 14px 20px;
  border-radius: 30px;
  border: 2px solid var(--gold);
  cursor: pointer;
  box-shadow: 0 3px 12px #0004;
}

#cartItems {
  margin: 15px 0;
  line-height: 2;
}

@media(max-width:500px) {
  .logo { font-size: 28px; }
  nav { gap: 15px; }
  .hero { min-height: 350px; }
  .section { padding: 40px 5%; }
}
</style>
</head>

<body>

<header>
  <div class="logo">VARA LAXMI</div>
  <div class="tagline">SAREES & BOUTIQUE</div>
  <p style="color:#e8c77e;margin-top:12px">
    Tradition • Beauty • Elegance
  </p>
</header>

<nav>
  <a href="#home">Home</a>
  <a href="#collections">Collections</a>
  <a href="#about">About Us</a>
  <a href="#contact">Contact</a>
</nav>

<section class="hero" id="home">
  <div class="hero-content">
    <h1>Elegance in Every Drape</h1>
    <p>
      Discover beautiful traditional, silk and
      designer sarees for every special occasion.
    </p>
    <a href="#collections" class="btn">
      Explore Collections
    </a>
  </div>
</section>

<section class="section" id="collections">
  <h2 class="section-title">Our Royal Collections</h2>
  <p class="subtitle">
    Find the perfect saree for your special moments.
  </p>

  <input
    class="search"
    id="search"
    type="search"
    placeholder="Search your favourite saree..."
    oninput="renderProducts()"
  >

  <div class="categories">
    <button class="active" onclick="setCategory('All',this)">All</button>
    <button onclick="setCategory('Silk',this)">Silk Sarees</button>
    <button onclick="setCategory('Wedding',this)">Wedding</button>
    <button onclick="setCategory('Designer',this)">Designer</button>
    <button onclick="setCategory('Cotton',this)">Cotton</button>
  </div>

  <div class="products" id="products"></div>
</section>

<section class="section about" id="about">
  <h2 class="section-title">Welcome to Vara Laxmi</h2>
  <p>
    At Vara Laxmi Sarees, we celebrate the beauty
    of Indian tradition. Our collection brings
    together timeless designs, beautiful colours
    and elegant styles for every occasion.
  </p>

  <div class="features">
    <div class="feature">
      <h3>🌸 Beautiful Designs</h3>
      <p>Elegant sarees for every occasion.</p>
    </div>
    <div class="feature">
      <h3>✨ Quality Collection</h3>
      <p>Carefully selected saree collections.</p>
    </div>
    <div class="feature">
      <h3>💛 Customer Care</h3>
      <p>Friendly assistance with every order.</p>
    </div>
  </div>
</section>

<section class="section contact" id="contact">
  <h2 class="section-title">Visit or Contact Us</h2>
  <p>We welcome online and in-store enquiries.</p>
  <p><b>WhatsApp:</b> +91 9493452359</p>
  <p><b>Instagram:</b> Add your Instagram ID</p>
  <p><b>Shop Address:</b> Add your shop address</p>
  <br>
  <a class="btn"
     href="https://wa.me/919493452359?text=Hello%20Vara%20Laxmi%20Sarees">
     Chat With Us on WhatsApp
  </a>
</section>

<footer>
  <h3 style="color:#d6ad60">VARA LAXMI SAREES</h3>
  <p>Thank you for choosing us.</p>
  <p>© 2026 Vara Laxmi. All Rights Reserved.</p>
</footer>

<button class="cart" onclick="showCart()">
  🛍️ Cart (<span id="cartCount">0</span>)
</button>

<script>
const whatsapp = "919493452359";

const sarees = [
  {
    name:"Royal Kanchipuram Silk",
    category:"Silk",
    price:2499,
    image:"https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=600"
  },
  {
    name:"Bridal Wedding Saree",
    category:"Wedding",
    price:3999,
    image:"https://images.unsplash.com/photo-1583391733956-6c78276477e7?w=600"
  },
  {
    name:"Designer Party Wear",
    category:"Designer",
    price:1999,
    image:"https://images.unsplash.com/photo-1610189012906-4c1c6d2f7a0a?w=600"
  },
  {
    name:"Traditional Cotton Saree",
    category:"Cotton",
    price:999,
    image:"https://images.unsplash.com/photo-1610030469983-98e550d6193c?w=600"
  },
  {
    name:"Golden Zari Silk Saree",
    category:"Silk",
    price:2999,
    image:"https://images.unsplash.com/photo-1583391733956-6c78276477e7?w=600"
  },
  {
    name:"Festive Designer Saree",
    category:"Designer",
    price:1799,
    image:"https://images.unsplash.com/photo-1610189012906-4c1c6d2f7a0a?w=600"
  }
];

let category = "All";
let cart = [];

function renderProducts() {
  const search = document.getElementById("search")
    .value.toLowerCase();

  const filtered = sarees.filter(s => {
    return (category === "All" || s.category === category)
      && s.name.toLowerCase().includes(search);
  });

  document.getElementById("products").innerHTML =
    filtered.map(s => `
      <div class="product">
        <img src="${s.image}" alt="${s.name}">
        <h3>${s.name}</h3>
        <p>${s.category} Collection</p>
        <p class="price">₹${s.price.toLocaleString("en-IN")}</p>
        <button class="btn" onclick="addToCart('${s.name}')">
          Add to Cart
        </button>
        <button class="btn" onclick="orderNow('${s.name}')">
          Order Now
        </button>
      </div>
    `).join("") || "<p>No sarees found.</p>";
}

function setCategory(value, button) {
  category = value;
  document.querySelectorAll(".categories button")
    .forEach(b => b.classList.remove("active"));
  button.classList.add("active");
  renderProducts();
}

function addToCart(name) {
  const item = sarees.find(s => s.name === name);
  cart.push(item);
  document.getElementById("cartCount").innerText = cart.length;
  alert(name + " added to your cart!");
}

function orderNow(name) {
  const item = sarees.find(s => s.name === name);
  const message =
    `Hello Vara Laxmi Sarees! I want to order ${name}. Price: ₹${item.price}. Please share availability and delivery details.`;

  window.open(
    "https://wa.me/" + whatsapp +
    "?text=" + encodeURIComponent(message),
    "_blank"
  );
}

function showCart() {
  if (cart.length === 0) {
    alert("Your cart is empty!");
    return;
  }

  const total = cart.reduce((sum, item) => sum + item.price, 0);

  const message =
    "Hello Vara Laxmi Sarees! My order:\n" +
    cart.map(item =>
      item.name + " - ₹" + item.price
    ).join("\n") +
    "\nTotal: ₹" + total +
    "\nPlease confirm availability and delivery details.";

  window.open(
    "https://wa.me/" + whatsapp +
    "?text=" + encodeURIComponent(message),
    "_blank"
  );
}

renderProducts();
</script>

</body>
</html>
